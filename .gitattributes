# Normalize line endings: scripts and configs run on Linux hosts, where CRLF
# breaks shebangs, heredocs and YAML parsing.
* text=auto eol=lf

*.sh     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.toml   text eol=lf

*.png    binary
*.jpg    binary
*.gif    binary
*.pdf    binary
*.go     text eol=lf
go.sum   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.svg    text eol=lf
