#!/usr/bin/env bash
# Forced command for the CI SSH key (authorized_keys: restrict,command="...").
#
# The key can never open a shell: it may only read status/history or update an
# application service to a local-registry image pinned by digest. Arguments
# are validated here and again by deploy itself.
set -euo pipefail

SERVICE_RE='^[a-z][a-z0-9-]*_[a-z][a-z0-9_-]*$'
IMAGE_RE='^127\.0\.0\.1:5000/[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+)?@sha256:[a-f0-9]{64}$'

deny() {
    logger -t deploy-ssh "denied: ${SSH_ORIGINAL_COMMAND:-<empty>}" 2>/dev/null || true
    echo "denied: allowed commands are 'status', 'history [count]' and 'app <service> <image@sha256>'" >&2
    exit 1
}

read -r -a args <<< "${SSH_ORIGINAL_COMMAND:-}"

case "${args[0]:-}" in
    status)
        [ "${#args[@]}" -eq 1 ] || deny ;;
    history)
        [ "${#args[@]}" -le 2 ] || deny
        [ "${#args[@]}" -eq 1 ] || [[ "${args[1]}" =~ ^[0-9]{1,3}$ ]] || deny ;;
    app)
        [ "${#args[@]}" -eq 3 ] || deny
        [[ "${args[1]}" =~ $SERVICE_RE && "${args[2]}" =~ $IMAGE_RE ]] || deny ;;
    *) deny ;;
esac

logger -t deploy-ssh "allowed: ${args[*]}" 2>/dev/null || true
DEPLOY_ACTOR=ci exec sudo -n /usr/local/sbin/deploy "${args[@]}"
