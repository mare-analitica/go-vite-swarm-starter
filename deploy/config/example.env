# Host configuration: copy to /etc/starter/config.env (root, 0644) and edit.
# No secrets here: they are generated on the host in /etc/starter/secrets.
#
# Every domain needs a DNS A record pointing to the server before its first
# deploy, or Let's Encrypt cannot issue the certificate.

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Presigned upload/download URLs point here: it must be public.
S3_DOMAIN=s3.example.com
MINIO_CONSOLE_DOMAIN=minio.example.com
N8N_DOMAIN=n8n.example.com
CI_DOMAIN=ci.example.com

# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# Uncomment to test against the staging CA (untrusted certificates, no rate limits).
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Who may open the admin consoles (MinIO console, n8n editor, Jenkins).
# Comma-separated CIDRs, e.g. your office IP. Documentation range below.
ADMIN_CIDRS=203.0.113.10/32

TIMEZONE=UTC

# Services the CI may update with "deploy app" (stack_service).
APP_SERVICES="app_api app_web"

# Git repository Jenkins builds (read access; a token is needed if private).
GIT_REPOSITORY_URL=https://github.com/your-org/your-repo.git
GIT_BRANCH=main
